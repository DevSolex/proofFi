# ProofFi gitignore

# Compiler output — gitignored except the JS contract bindings needed for deployment
contract/managed/
# Exception: keep the compiled JS contract so Render/CI can import it without running compactc
!contract/managed/credit-attestation/contract/
!contract/managed/credit-attestation/contract/index.js
!contract/managed/credit-attestation/contract/index.d.ts

# Issuer keypair — NEVER COMMIT PRIVATE KEY MATERIAL
issuer-service/keys/

# Node modules
node_modules/

# TypeScript build output
dist/

# Frontend build output and env
frontend/dist/
frontend/.env
frontend/.env.local
frontend/node_modules/
frontend/playwright-report/
frontend/test-results/

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo

# OS artifacts
.DS_Store
Thumbs.db

# Test coverage
coverage/
.nyc_output/
