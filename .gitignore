frontend/dist/
frontend/.env
frontend/.env.local
frontend/node_modules/
frontend/playwright-report/
frontend/test-results/

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo

# OS artifacts
.DS_Store
Thumbs.db

# Test coverage
coverage/
.nyc_output/
