{
  "name": "prooffi",
  "version": "0.1.0",
  "description": "Credit attestation smart contract on Midnight Network",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke-test": "npx tsx tests/smoke-test.ts",
    "issuer:generate": "npx tsx issuer-service/index.ts generate",
    "compile": "compact --skip-zk contract/credit-attestation.compact contract/managed/credit-attestation",
    "compile:full": "compact contract/credit-attestation.compact contract/managed/credit-attestation"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.19.0",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0"
  }
}
