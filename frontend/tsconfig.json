{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@contract/*": ["../contract/managed/credit-attestation/contract/*"],
      "@issuer/*":   ["../issuer-service/*"]
    }
  },
  "include": ["src", "tests"]
}
